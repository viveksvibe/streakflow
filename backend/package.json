    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "start": "node dist/index.js",
    "prepare": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run"
  },
