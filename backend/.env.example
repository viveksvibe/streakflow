# ──────────────────────────────────────────────────
# StreakFlow Backend — Environment Variables (EXAMPLE)
# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit it.
# ──────────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=3000

# Database (PostgreSQL — Neon, Supabase, or local)
# Pooled connection used by the app at runtime
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/DBNAME?sslmode=require
# Direct (non-pooled) connection used by Prisma Migrate
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/DBNAME?sslmode=require

# Frontend origin allowed by CORS
FRONTEND_URL=http://localhost:5173

# JWT secrets — generate strong random values (min 24 chars each)
# Tip: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret-value
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret

# JWT token lifetimes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Bcrypt cost factor (8–15)
BCRYPT_SALT_ROUNDS=12

# Streak freeze credits granted per month
MONTHLY_FREEZE_CREDITS=2

# Cloudinary — optional, only needed for avatar uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google OAuth — optional, only needed for "Sign in with Google"
GOOGLE_CLIENT_ID=
