# ──────────────────────────────────────────────────
# StreakFlow Backend — Environment Variables (EXAMPLE)
# Copy this file to `.env` and adjust. `.env` is gitignored.
#
# Local Postgres is provided by scripts/local-db.sh (see README).
# ──────────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=3000

# Database — local Postgres (default) or any Postgres connection string
DATABASE_URL=postgresql://streakflow:streakflow@127.0.0.1:5433/streakflow
DIRECT_DATABASE_URL=postgresql://streakflow:streakflow@127.0.0.1:5433/streakflow

# Frontend origin allowed by CORS
FRONTEND_URL=http://localhost:5173

# JWT secrets — min 24 chars each. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret-value
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret

# JWT token lifetimes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Bcrypt cost factor (8–15)
BCRYPT_SALT_ROUNDS=12

# Streak freeze credits granted per month
MONTHLY_FREEZE_CREDITS=2

# Cloudinary — optional (avatar uploads)
CLOUDINARY_CLOUD_NAME=dcc7mdxo2
CLOUDINARY_API_KEY=114954574352977
CLOUDINARY_API_SECRET=q6FTL4wLmE-3G90Yw-STvWKYJ9I

GOOGLE_CLIENT_ID=662599669741-ri8g2jc4m94i8ltjt9kci7hebc6sp4vn.apps.googleusercontent.com
