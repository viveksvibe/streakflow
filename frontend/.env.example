# ──────────────────────────────────────────────────
# StreakFlow Frontend — Environment Variables (EXAMPLE)
# Copy this file to `.env`. `.env` is gitignored.
#
# NOTE: Vite only exposes variables prefixed with `VITE_` to browser code.
# Any var without that prefix is ignored by import.meta.env.
# ──────────────────────────────────────────────────

# Backend API base URL
VITE_API_URL="http://localhost:3000/api/v1"

# Google OAuth client ID (public value; used by @react-oauth/google)
# Must be prefixed with VITE_ so the browser bundle can read it.
VITE_GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
