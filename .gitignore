# ─────────────────────────────────────────────────────────────
# StreakFlow — Root .gitignore
# Covers Monorepo Root, Frontend, and Backend
# ─────────────────────────────────────────────────────────────

# Dependencies
node_modules/
.pnp
.pnp.js

# Build Outputs & Bundles
dist/
dist-ssr/
build/
out/
.vite/
*.tsbuildinfo
.eslintcache

# Environment variables & secrets (NEVER commit secrets)
.env
.env.*
.env.local
.env.*.local
!.env.example
*.pem
*.p12
*.key
*.cert
*.bak

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing & Coverage
coverage/
.nyc_output/
vitest-reporters/

# Local Database & Prisma
prisma/*.db
prisma/*.db-journal

# Temporary caches & scratch files
.cache/
.temp/
.tmp/
uploads/

# Agent / Tooling state
.agents/
.devin/
skills-lock.json

# Operating System Files
.DS_Store
.DS_Store?
._*
Thumbs.db
Desktop.ini

# Windows / WSL Alternate Data Stream artifacts
*Zone.Identifier*
*:Zone.Identifier

# IDE & Editor configurations
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
