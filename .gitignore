# ──────────────────────────────────────────────
# StreakFlow — root .gitignore
# Covers both frontend/ and backend/ (patterns are not path-anchored)
# ──────────────────────────────────────────────

# Dependencies
node_modules/

# Build output
dist/
build/
.vite/
*.tsbuildinfo
.eslintcache

# Env files & secrets — never commit these
.env
.env.*
.env.local
.env.*.local
!.env.example
*.pem
*.p12
*.key

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test / coverage
coverage/
.nyc_output/

# Caches
.cache/
.temp/
.tmp/

# Local uploads
uploads/

# OS junk
.DS_Store
.DS_Store?
._*
Thumbs.db
Desktop.ini

# Windows / WSL "Zone.Identifier" alternate-data-stream artifacts
*Zone.Identifier*
*:Zone.Identifier

# Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
